# Referencia de variables. Copia a .env (que NO se sube a git) o configúralas como secretos en Supabase.
# Nunca pongas estos valores en preview/config.js ni en ningún archivo del frontend.

# Proyecto Supabase (públicos: también van en preview/config.js)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor (Edge Functions / CLI). SECRETOS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Correo saliente para la cola public.cola_correos (pendiente)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Litigar Group <notificaciones@litigar.co>"
